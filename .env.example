# Copy to .env.local for local dev. On Vercel: Project > Settings > Environment Variables.

# Google Apps Script Web App URL (ends with /exec)
APPS_SCRIPT_URL=
# Long random string. Same value goes in Apps Script > Script Properties > SHARED_SECRET
APPS_SCRIPT_SECRET=

# Tracking (loaded only after cookie consent)
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
